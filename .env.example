# Copy to .env and fill in. Never commit secrets.

# Mongo (Hostinger geek_crawler — read-only for this service)
MONGO_CRAWLER_URL=mongodb://user:pass@mongo-host:27017/?authSource=admin
MONGO_DB_NAME=geek_crawler

# Qdrant (compose sets QDRANT_URL=http://qdrant:6333 inside the stack)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=geek_crawler_chunks
# QDRANT_API_KEY=

# OpenAI embeddings
OPENAI_API_KEY=sk-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional shared secret for index/query (send as X-Api-Key)
# API_KEY=

# Chunking (plan: ~500–800 tokens, small overlap)
CHUNK_SIZE_TOKENS=650
CHUNK_OVERLAP_TOKENS=80
PAGE_BATCH_SIZE=25
EMBED_BATCH_SIZE=64

HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO
