# Copy to .env and fill in. Never commit secrets.

# Mongo (Hostinger geek_crawler — read-only for this service)
MONGO_CRAWLER_URL=mongodb://user:pass@mongo-host:27017/?authSource=admin
MONGO_DB_NAME=geek_crawler

# Qdrant (compose sets QDRANT_URL=http://qdrant:6333 inside the stack)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=geek_crawler_chunks
QDRANT_AD_TEMPLATES_COLLECTION=geek_ad_templates
QDRANT_UPSERT_DELAY_SECONDS=2
# QDRANT_API_KEY=

# OpenAI embeddings
OPENAI_API_KEY=sk-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Mandatory service secret (send as X-Api-Key). LOCAL_TEST_MODE is test-only.
API_KEY=replace-with-a-long-random-service-secret
LOCAL_TEST_MODE=false
CRAWLER_OWNER_ID=system:crawler
CRAWLER_VISIBILITY=service
# JSON map of GeekAPI manifest signing key IDs to secrets.
CONTEXT_MANIFEST_SIGNING_KEYS={"current":"replace-with-manifest-signing-secret"}
# Must match GeekAPI's SKILL_SNAPSHOT_SIGNING_KEY and key ID.
SKILL_SNAPSHOT_SIGNING_KEY=replace-with-skill-snapshot-signing-secret
SKILL_SNAPSHOT_SIGNING_KEY_ID=gcc-skills-1
# Rollout gates for immutable indexing/tombstones and signed-manifest retrieval.
CONTEXT_ASSET_INDEXING_ENABLED=true
CONTEXT_MANIFEST_QUERY_ENABLED=true

# Legacy uniform chunk knobs (unused by parent/child path except docs)
CHUNK_SIZE_TOKENS=650
CHUNK_OVERLAP_TOKENS=80

# Parent/child indexing
CHILD_CHUNK_SIZE_TOKENS=200
CHILD_CHUNK_OVERLAP_TOKENS=40
PARENT_CHUNK_SIZE_TOKENS=1000
PARENT_CHUNK_OVERLAP_TOKENS=80

PAGE_BATCH_SIZE=25
EMBED_BATCH_SIZE=32
OPENAI_EMBEDDING_TOKENS_PER_MINUTE=400000
OPENAI_EMBEDDING_MAX_BATCH_TOKENS=50000
OPENAI_EMBEDDING_MAX_RETRIES=8
OPENAI_EMBEDDING_RETRY_MAX_SECONDS=60

# Durable scheduler (production enables this in deploy/hostinger-compose.yml)
INDEX_SCHEDULER_ENABLED=false
INDEX_SCHEDULER_INTERVAL_SECONDS=7200
INDEX_SCHEDULER_POLL_SECONDS=60
INDEX_JOB_LEASE_SECONDS=900
INDEX_JOB_HEARTBEAT_SECONDS=60
INDEX_SCHEDULER_MAX_ATTEMPTS=5
INDEX_SCHEDULER_RETRY_SECONDS=7200

# Hybrid retrieval pool sizes
HYBRID_DENSE_LIMIT=30
HYBRID_LEXICAL_LIMIT=30
RERANK_POOL_SIZE=25

# Cohere rerank (soft-disabled when COHERE_API_KEY unset)
# COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-english-v3.0
RERANK_ENABLED=true

HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO

# Push index status → GeekAPI → SignalR (GeekCrawlerRagIndexEvent). Optional.
# INDEX_STATUS_WEBHOOK_URL=https://api.geekatyourspot.com/api/geek-crawler/internal/rag/index-status
# INDEX_STATUS_WEBHOOK_KEY=  # defaults to API_KEY if unset; use GEEK_BACKEND_API_KEY in prod
